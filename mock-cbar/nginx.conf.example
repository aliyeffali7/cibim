# /etc/nginx/sites-available/cibim-api  (then symlink into sites-enabled)
# Replace cibim-api.example.az with your subdomain. Get HTTPS afterwards with:
#   sudo certbot --nginx -d cibim-api.example.az
server {
    listen 80;
    server_name cibim-api.example.az;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
