# Public HTTPS origin, used to build absolute scaRedirect links.
# Leave empty to derive it from the request (nginx passes X-Forwarded-* headers).
PUBLIC_BASE_URL=https://cibim-api.example.az

# true = enforce frequencyPerDay (429 ACCESS_EXCEEDED). Off for development.
MOCK_ENFORCE_FREQUENCY=false

# Where the container port is published on the VPS.
BIND_ADDR=127.0.0.1
HOST_PORT=4000
