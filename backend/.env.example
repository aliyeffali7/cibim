# Database password. Change it on the server.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The bank gateway (our mock CBAR server).
MOCK_CBAR_URL=https://cibim.farahmobilya.az

# Where the bank's approval page sends the user back. {id} = connection ID.
# For Expo Go use something like exp://192.168.1.10:8081/--/connections/{id},
# or let the app send redirectUri in POST /connections.
APP_REDIRECT_URL=cibim://connections/{id}

# Re-sync bank data automatically when it is older than this.
SYNC_STALE_AFTER=10m

BIND_ADDR=127.0.0.1
HOST_PORT=8080
